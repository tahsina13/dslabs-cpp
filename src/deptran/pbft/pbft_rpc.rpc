namespace janus;

struct PreprepareMessage {
  locid_t server_id; 
  uint64_t view;
  slotid_t seqno;
  string digest; 
}; 

struct PrepareMessage {
  locid_t server_id; 
  uint64_t view; 
  slotid_t seqno; 
  string digest; 
};

struct CommitMessage {
  locid_t server_id; 
  uint64_t view; 
  slotid_t seqno; 
  string digest; 
}; 

struct CheckpointMessage {
  locid_t server_id;
  slotid_t ckpt_seqno;   
  string digest; 
}; 

struct ViewChangeMessage {
  locid_t server_id; 
  uint64_t new_view; 
  slotid_t ckpt_seqno; 
  map<locid_t, CheckpointMessage> checkpoints; 
  map<slotid_t, PreprepareMessage> preprepares; 
  map<slotid_t, map<locid_t, PrepareMessage>> prepares; 
  string digest; 
}; 

struct NewViewMessage {
  locid_t server_id; 
  uint64_t new_view; 
  map<locid_t, ViewChangeMessage> view_changes; 
  map<slotid_t, PreprepareMessage> preprepares; 
  string digest; 
}; 

abstract service Pbft {
  defer Preprepare(PreprepareMessage mesg, 
                   MarshallDeputy md_cmd, 
                   uint64_t timestamp, 
                   cliid_t client_id); 
  defer Prepare(PrepareMessage mesg); 
  defer Commit(CommitMessage mesg); 

  defer Checkpoint(CheckpointMessage mesg); 

  defer ViewChange(ViewChangeMessage mesg); 
  defer NewView(NewViewMessage mesg); 
}
