namespace janus;

struct Request {
  uint64_t timestamp; 
  cliid_t client_id; 
  string signature; 
}; 

struct Reply {
  uint64_t view; 
  uint64_t timestamp; 
  cliid_t client_id; 
  svrid_t server_id; 
  string reply; 
  string signature; 
}; 

struct PreprepareMessage {
  svrid_t server_id; 
  uint64_t view;
  slotid_t seqno;
  string digest; 
  string signature; 
}; 

struct PrepareMessage {
  svrid_t server_id; 
  uint64_t view; 
  slotid_t seqno; 
  string digest; 
  string signature; 
};

struct CommitMessage {
  svrid_t server_id; 
  uint64_t view; 
  slotid_t seqno; 
  string digest; 
  string signature; 
}; 

struct CheckpointMessage {
  svrid_t server_id;
  slotid_t ckpt_seqno;   
  string ckpt_digest; 
  string signature; 
}; 

struct ViewChangeMessage {
  svrid_t server_id; 
  uint64_t new_view; 
  slotid_t ckpt_seqno; 
  map<svrid_t, CheckpointMessage> checkpoints; 
  map<slotid_t, PreprepareMessage> preprepares; 
  map<slotid_t, map<svrid_t, PrepareMessage>> prepares; 
  string signature; 
}; 

struct NewViewMessage {
  svrid_t server_id; 
  uint64_t new_view; 
  map<svrid_t, ViewChangeMessage> view_changes; 
  map<slotid_t, PreprepareMessage> preprepares; 
  string signature; 
}; 

abstract service Pbft {
  defer Preprepare(PreprepareMessage mesg, 
                   MarshallDeputy md_cmd,
                   Request req); 
  defer Prepare(PrepareMessage mesg); 
  defer Commit(CommitMessage mesg); 

  defer Checkpoint(CheckpointMessage mesg); 

  defer ViewChange(ViewChangeMessage mesg); 
  defer NewView(NewViewMessage mesg); 
}
