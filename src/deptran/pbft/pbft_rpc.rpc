namespace janus;

struct PreprepareMessage {
  siteid_t server_id; 
  uint64_t view;
  slotid_t seqno;
  vector<uint8_t> digest; 
  vector<uint8_t> signature; 
}; 

struct PrepareMessage {
  siteid_t server_id; 
  uint64_t view; 
  slotid_t seqno; 
  vector<uint8_t> digest; 
  vector<uint8_t> signature; 
};

struct CommitMessage {
  siteid_t server_id; 
  uint64_t view; 
  slotid_t seqno; 
  vector<uint8_t> digest; 
  vector<uint8_t> signature; 
}; 

struct CheckpointMessage {
  siteid_t server_id;
  slotid_t ckpt_seqno;   
  vector<uint8_t> ckpt_digest; 
  vector<uint8_t> signature; 
}; 

struct ViewChangeMessage {
  siteid_t server_id; 
  uint64_t new_view; 
  slotid_t ckpt_seqno; 
  map<siteid_t, CheckpointMessage> checkpoints; 
  map<slotid_t, PreprepareMessage> preprepares; 
  map<slotid_t, map<siteid_t, PrepareMessage>> prepares; 
  vector<uint8_t> signature; 
}; 

struct NewViewMessage {
  siteid_t server_id; 
  uint64_t new_view; 
  map<siteid_t, ViewChangeMessage> view_changes; 
  map<slotid_t, PreprepareMessage> preprepares; 
  vector<uint8_t> signature; 
}; 

abstract service Pbft {
  defer Preprepare(PreprepareMessage mesg, 
                   MarshallDeputy md_cmd, 
                   uint64_t timestamp, 
                   cliid_t client_id); 
  defer Prepare(PrepareMessage mesg); 
  defer Commit(CommitMessage mesg); 

  defer Checkpoint(CheckpointMessage mesg); 

  defer ViewChange(ViewChangeMessage mesg); 
  defer NewView(NewViewMessage mesg); 
}
