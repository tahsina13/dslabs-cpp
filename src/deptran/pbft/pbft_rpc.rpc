struct PreprepareMessage {
  uint64_t view;
  slotid_t seqno;
  uint64_t digest; 
  svrid_t server_id; 
}; 

struct PrepareMessage {
  uint64_t view; 
  slotid_t seqno; 
  uint64_t digest;  
  svrid_t server_id; 
};

struct CommitMessage {
  uint64_t view; 
  slotid_t seqno; 
  uint64_t digest; 
  svrid_t server_id; 
}; 

struct PreparedMessage {
  PreprepareMessage preprepare; 
  vector<PrepareMessage> prepares; 
}; 

struct CommittedMessage {
  PreprepareMessage preprepare; 
  vector<PrepareMessage> prepares; 
  vector<CommitMessage> commits; 
}

struct CheckpointMessage {
  slotid_t ckpt_seqno;   
  uint64_t digest; 
}; 

struct ViewChangeMessage {
  uint64_t new_view; 
  slotid_t ckpt_seqno; 
  vector<CheckpointMessage> checkpoints; 
  vector<PreprepareMessage> preprepares; 
  vector<vector<PrepareMessage>> prepares; 
}; 

struct NewViewMessage {
  uint64_t new_view; 
  vector<ViewChangeMessage> view_changes; 
  vector<PreprepareMessage> preprepares; 
}; 

abstract service Pbft {
  defer Preprepare(PreprepareMessage mesg, 
                   MarshallDeputy md_cmd, 
                   uint64_t timestamp, 
                   cliid_t client_id); 
  defer Prepare(PrepareMessage mesg); 
  defer Commit(CommitMessage mesg); 

  defer Prepared(PreparedMessage mesg); 
  defer Committed(CommittedMessage mesg); 
  
  defer Checkpoint(CheckpointMessage mesg); 

  defer ViewChange(ViewChangeMessage mesg); 
  defer NewView(NewViewMessage mesg); 
}

abstract service PbftClient {
  defer SendRequest(MarshallDeputy md_cmd,
                    uint64_t timestamp,
                    cliid_t client_id); 

  defer SendReply(uint64_t current_view,
                  uint64_t timestamp,
                  cliid_t client_id,
                  svrid_t server_id,
                  string res); 
}